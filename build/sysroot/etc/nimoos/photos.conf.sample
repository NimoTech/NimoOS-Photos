[common]
RuntimePath = /var/run/nimoos
LogPath = /var/log/nimoos

[photos]
DataPath = /DATA/.system_data/photos
MLEndpoint = http://127.0.0.1:3003
Workers = 3
# WatchDirs left blank = auto mode: watches the system disk + all mounted user
# partitions (RAID/standalone storage), following mounts dynamically.
# Uncomment only when a manual restriction is needed: WatchDirs = /DATA/Gallery,/DATA/Documents,/DATA/Downloads
FacesEnabled = true
# PreviewPregen = false ; whether to pre-generate video hover previews (preview.mp4); default false = generate on hover
