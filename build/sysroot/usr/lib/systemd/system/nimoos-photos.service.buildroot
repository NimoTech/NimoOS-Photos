[Unit]
After=nimoos-message-bus.service
After=docker.service
Description=NimoOS Photos Service

[Service]
ExecStartPre=/usr/bin/nimoos-photos -v
ExecStart=/usr/bin/nimoos-photos -c /etc/nimoos/photos.conf
Restart=always
Type=notify
# Same memory backstop as nimoos-photos.service (#26 P3). The 2026-07-22
# 22GB x9 OOM crash loop happened precisely on the buildroot variant that
# lacked this config: both units must be changed together, or whichever one
# is missed becomes the next escape hatch.
MemoryHigh=3G
MemoryMax=4G
RestartSec=30
Environment=GOMEMLIMIT=2500MiB
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
