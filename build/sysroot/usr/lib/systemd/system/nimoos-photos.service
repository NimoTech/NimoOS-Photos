[Unit]
After=nimoos-message-bus.service
After=docker.service
Description=NimoOS Photos Service

[Service]
ExecStartPre=/usr/bin/nimoos-photos -v
ExecStart=/usr/bin/nimoos-photos -c /etc/nimoos/photos.conf
Restart=always
Type=notify
# P3 fallback: the indexing pipeline has already been reworked to stream reads
# (P1) + fast stat-based skipping (P2), so it shouldn't be OOMing on whole-file
# reads anymore; this adds a second kernel/Go-level backstop in case some
# unknown issue drags down the whole 31G-RAM box. When MemoryHigh is hit,
# the cgroup first reclaims page cache etc. as a soft limit; MemoryMax is the
# hard ceiling (crossing it gets Photos OOM-killed by the cgroup, taking down
# only this one service, not the other 15+ systemd services). GOMEMLIMIT lets
# the Go runtime's GC trigger proactively before actually hitting the cgroup
# limit, reducing the odds of a hard kernel kill; RestartSec=30 avoids
# Restart=always spinning into a useless "crash-restart-crash again" loop
# immediately after a crash.
MemoryHigh=3G
MemoryMax=4G
RestartSec=30
Environment=GOMEMLIMIT=2500MiB
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
